# =====================================================================
# CLIENT-SIDE (exposed to the browser — never put secrets here)
# =====================================================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =====================================================================
# SERVER-SIDE (Vercel project env vars only — NEVER expose to the client)
# =====================================================================

# Resend API key for transactional email.
# Get it from https://resend.com/api-keys.
# Set this in: Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_your_new_key_here

# "From" address shown in the user's inbox. Must be a verified Resend sender
# (or "onboarding@resend.dev" for testing — only delivers to the Resend
# account's own email).
RESEND_FROM=Legal Associates <orders@legalassociatesodisha.com>

# Public site URL used to build CTA links inside the email.
SITE_URL=https://www.legalassociatesodisha.com
